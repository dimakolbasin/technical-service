{
  "name": "technical-service",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "astro build && node scripts/minify-css.mjs",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/compare-builds.mjs --verify-snapshot tests/eleventy-semantic-baseline.json dist && node scripts/verify-build.mjs",
    "test": "npm run format:check && npm run check && npm run build && npm run verify",
    "test:e2e": "npm run build && playwright test",
    "serve": "astro preview",
    "dev": "astro dev",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.0",
    "astro": "^7.2.7",
    "esbuild": "0.28.2",
    "husky": "^9.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
